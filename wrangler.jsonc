// Cloudflare Workers deployment of the Team Huntington Hub.
// Build first (`npm run build`), then deploy through the release process in
// docs/DEPLOYMENT.md. Secrets are set with `wrangler secret put` and never
// committed; see docs/CONFIGURATION.md for the full list.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vscode",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".output/public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Temporary migration preview. The production domain is not in this account yet.
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://vscode.ohiotundra88.workers.dev",
    "AUTH_MODE": "disabled",
    "HUB_DB_URL": "https://rwh-db.madebyotten.com",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "Team Huntington Hub <hub@send.madebyaspire.com>",
    "HUB_REQUIRE_SIGN_IN": "false",
  },
  "d1_databases": [
    {
      "binding": "HUB_SESSIONS",
      "database_name": "ride-with-huntington-sessions",
      "database_id": "3b29d26d-da7c-4a7f-8d2c-1dd5c2943781",
      "migrations_dir": "deploy/cloudflare/d1-migrations",
    },
  ],
  // R2 is not enabled in this Cloudflare account yet. Add HUB_FILES after
  // enabling R2 and creating ride-with-huntington-files.
}
